# Bluesky credentials — use an App Password, not your main password
# Generate one at: Settings → Privacy and security → App passwords
BSKY_HANDLE=yourhandle.bsky.social
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Optional: number of liked posts to fetch (default: 100)
BSKY_FEED_LIMIT=100

# Optional: output file path (default: feed.xml)
OUTPUT_FILE=feed.xml
